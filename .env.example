# Copy to .env and fill in. .env is gitignored.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: better web search (2k queries/mo free at brave.com/search/api).
# Without it, web_search falls back to DuckDuckGo, which rate-limits sometimes.
# BRAVE_API_KEY=BSA...

# Optional tier overrides — see `jarvis config`
# JARVIS_ORCHESTRATOR=openai/gpt-5.6-luna
# JARVIS_WORKER=openai/gpt-5.6-luna
# JARVIS_CHEAP=qwen/qwen3.7-flash
