.env
.env.local
.venv/
__pycache__/
*.egg-info/
memory/*.md
.jarvis_history
traces/
designs/

# Avatars are the owner's, not the project's — one directory each
# (avatar.svg + avatar.json). See jarvis/avatars.py; scaffold with
# `jarvis avatar new <slug>`.
avatars/

# Cloned/hybrid voices never enter git. The real store is outside the repo
# (~/.local/share/jarvis/voices — see jarvis/pocket.py); this is the backstop
# for a JARVIS_VOICES pointed inside the checkout.
voices/

# Scratch output from tests/browser/marks_check.py.
marks_*.png

# long-bench run output: whole synthetic worlds plus per-run results.
longbench/runs/

# swecompare run output: per-instance checkouts and predictions.
swecompare/runs/

# swebench harness build/eval logs.
logs/
